<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>N &amp; N Lyte's Plumbing Services | Barbados</title>
<meta name="description" content="Father-and-son plumbing outfit serving all 11 parishes of Barbados — household repairs, new-build water mains, and event plumbing. Call, WhatsApp, or request a quote.">
<meta name="theme-color" content="#00297d">
<link rel="icon" type="image/x-icon" href="data:image/x-icon;base64,">
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<meta property="og:title" content="N &amp; N Lyte's Plumbing Services">
<meta property="og:description" content="Father-and-son plumbing outfit serving all 11 parishes of Barbados — household repairs, new-build water mains, and event plumbing.">
<meta property="og:type" content="website">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap');

  :root{
    --paper:#eef1f3;
    --paper-raised:#ffffff;
    --ink:#10151b;
    --ink-soft:#4b5763;
    --line:#c7d0d6;
    --blue:#00297d;
    --blue-deep:#001c57;
    --blue-tint:#e7ecfa;
    --gold:#c98a12;
    --gold-bright:#ffc72c;
    --chrome-a:#dde3e7;
    --chrome-b:#8b98a3;
    --wa:#25d366;
    --wa-tint:#1da851;
    --shadow: 0 1px 2px rgba(16,21,27,.06), 0 8px 24px -12px rgba(16,21,27,.18);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#0b0f14;
      --paper-raised:#131920;
      --ink:#edf1f4;
      --ink-soft:#9dacb8;
      --line:#29333c;
      --blue:#5b8fff;
      --blue-deep:#7ea3ff;
      --blue-tint:#161f30;
      --gold:#ffd666;
      --gold-bright:#ffd666;
      --chrome-a:#3a444d;
      --chrome-b:#6b7680;
      --wa:#25d366;
      --wa-tint:#1fbf5c;
      --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px -16px rgba(0,0,0,.6);
    }
  }
  :root[data-theme="dark"]{
    --paper:#0b0f14;
    --paper-raised:#131920;
    --ink:#edf1f4;
    --ink-soft:#9dacb8;
    --line:#29333c;
    --blue:#5b8fff;
    --blue-deep:#7ea3ff;
    --blue-tint:#161f30;
    --gold:#ffd666;
    --gold-bright:#ffd666;
    --chrome-a:#3a444d;
    --chrome-b:#6b7680;
    --wa:#3ddc84;
    --wa-tint:#132a1f;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px -16px rgba(0,0,0,.6);
  }

  *{box-sizing:border-box;}
  html{background:var(--paper); scroll-behavior:smooth;}
  section[id]{scroll-margin-top:92px;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Work Sans', ui-sans-serif, system-ui, sans-serif;
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;}
  h1,h2,h3{
    font-family:'Oswald', ui-sans-serif, system-ui, sans-serif;
    text-transform:uppercase;
    letter-spacing:.01em;
    text-wrap:balance;
    margin:0;
    color:var(--ink);
  }
  .eyebrow{
    font-family:'IBM Plex Mono', ui-monospace, monospace;
    font-size:.72rem;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--blue);
  }
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
  .pipe-rule{
    height:3px;
    background:linear-gradient(90deg, transparent, var(--chrome-a) 8%, var(--chrome-b) 50%, var(--chrome-a) 92%, transparent);
    border:none;
    opacity:.9;
  }

  /* header */
  header{
    position:sticky; top:0; z-index:20;
    background:color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-row{
    display:flex; align-items:center; justify-content:space-between;
    gap:16px; padding:14px 24px;
  }
  .brand{display:flex; align-items:center; gap:10px; text-decoration:none;}
  .brand img{height:46px;width:auto;filter:drop-shadow(0 1px 1px rgba(0,0,0,.25));}
  .brand-text{display:flex; flex-direction:column; line-height:1.15;}
  .brand-text strong{font-family:'Oswald'; font-size:1.02rem; letter-spacing:.02em; text-transform:uppercase;}
  .brand-text span{font-family:'IBM Plex Mono'; font-size:.66rem; color:var(--ink-soft); letter-spacing:.08em;}
  nav.links{display:flex; gap:28px; font-size:.92rem; font-weight:500;}
  nav.links a{text-decoration:none; color:var(--ink-soft); transition:color .15s;}
  nav.links a:hover{color:var(--blue);}
  .call-btn{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--blue); color:#fff; text-decoration:none;
    font-weight:600; font-size:.86rem; padding:10px 18px; border-radius:6px;
    white-space:nowrap;
    box-shadow:var(--shadow);
    transition:background .15s, transform .15s;
  }
  .call-btn:hover{background:var(--blue-deep); transform:translateY(-1px);}
  .call-btn:focus-visible, a:focus-visible, button:focus-visible{outline:2px solid var(--gold-bright); outline-offset:2px;}
  @media (max-width:760px){ nav.links{display:none;} }

  /* hero */
  .hero{
    padding:64px 0 56px;
    display:grid; grid-template-columns:auto 1fr; gap:40px; align-items:center;
  }
  .hero-badge{
    animation: rise .5s ease-out both;
  }
  .hero-badge img{
    width:min(280px, 34vw);
    height:auto;
    filter:drop-shadow(0 10px 22px rgba(16,21,27,.22));
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .hero-badge img{ filter:drop-shadow(0 10px 26px rgba(0,0,0,.55)); }
  }
  :root[data-theme="dark"] .hero-badge img{ filter:drop-shadow(0 10px 26px rgba(0,0,0,.55)); }
  .hero-copy{animation: rise .5s .08s ease-out both;}
  .hero .eyebrow{display:block; font-size:.82rem;}
  .hero h1{
    font-size:clamp(2rem, 4.4vw, 3.1rem); line-height:1.08; margin-top:12px; letter-spacing:.005em;
  }
  .hero h1 em{
    font-style:normal; color:var(--blue);
  }
  .hero p.lede{
    font-size:1.04rem; font-weight:400; line-height:1.65; color:var(--ink-soft);
    max-width:46ch; margin-top:18px; padding-left:16px; border-left:2px solid var(--line);
  }
  .hero-ctas{display:flex; gap:14px; margin-top:26px; flex-wrap:wrap;}
  .btn-outline{
    display:inline-flex; align-items:center; gap:8px;
    border:1px solid var(--line); text-decoration:none; color:var(--ink);
    font-weight:600; font-size:.86rem; padding:10px 18px; border-radius:6px;
    transition:border-color .15s, background .15s;
  }
  .btn-outline:hover{border-color:var(--blue); background:var(--blue-tint);}
  @keyframes rise{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }
  @media (prefers-reduced-motion: reduce){ *{animation:none !important; transition:none !important;} html{scroll-behavior:auto;} }
  @media (max-width:760px){ .hero{grid-template-columns:1fr; padding-top:40px; text-align:center;} .hero-badge{margin:0 auto;} .hero-badge img{width:min(220px, 60vw);} .hero-ctas{justify-content:center;} .hero p.lede{border-left:none; padding-left:0; margin-left:auto; margin-right:auto;} }

  /* trust strip */
  .trust{
    padding:22px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    background:var(--paper-raised);
  }
  .trust-row{
    display:grid; grid-template-columns:repeat(3,1fr); gap:18px;
    font-family:'IBM Plex Mono'; font-size:.76rem; color:var(--ink-soft);
  }
  .trust-row div{display:flex; align-items:center; gap:9px;}
  .trust-row strong{color:var(--ink); font-weight:600;}
  .dot{width:6px;height:6px;border-radius:50%;background:var(--gold-bright); flex:none;}
  @media (max-width:820px){ .trust-row{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .trust-row{grid-template-columns:1fr;} }

  /* section shell */
  section{padding:72px 0;}
  .section-head{max-width:60ch; margin-bottom:40px;}
  .section-head h2{font-size:clamp(1.6rem, 3vw, 2.15rem); margin-top:8px;}
  .section-head p{color:var(--ink-soft); margin-top:12px; font-size:1.02rem;}

  /* services */
  .svc-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:20px;}
  .svc-card{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:14px;
    padding:26px 26px 24px; box-shadow:var(--shadow); display:flex; flex-direction:column; gap:14px;
  }
  .svc-top{display:flex; align-items:flex-start; justify-content:space-between; gap:12px;}
  .svc-icon{
    width:46px; height:46px; border-radius:10px; flex:none;
    background:var(--blue-tint); color:var(--blue);
    display:flex; align-items:center; justify-content:center;
  }
  .svc-tag{font-family:'IBM Plex Mono'; font-size:.68rem; color:var(--ink-soft); letter-spacing:.06em; padding-top:4px;}
  .svc-card h3{font-size:1.15rem; letter-spacing:.005em;}
  .svc-card ul{margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:8px;}
  .svc-card li{
    font-size:.94rem; color:var(--ink-soft); padding-left:16px; position:relative;
  }
  .svc-card li::before{
    content:""; position:absolute; left:0; top:.62em; width:6px; height:2px; background:var(--gold);
  }
  @media (max-width:760px){ .svc-grid{grid-template-columns:1fr;} }

  /* gallery */
  .gallery{columns:3 240px; column-gap:20px;}
  .gallery figure{
    margin:0 0 20px; break-inside:avoid; background:var(--paper-raised);
    border:1px solid var(--line); border-radius:12px; overflow:hidden; box-shadow:var(--shadow);
  }
  .gallery img{width:100%; display:block; filter:saturate(.94) contrast(1.03);}
  .gallery figcaption{
    padding:12px 14px; font-family:'IBM Plex Mono'; font-size:.7rem; color:var(--ink-soft);
    line-height:1.55; letter-spacing:.01em;
  }
  @media (max-width:600px){ .gallery{columns:1;} }

  /* about */
  .about-text p{
    color:var(--ink-soft); margin:0 0 16px; font-size:1.02rem;
  }
  .about-text p:last-child{margin-bottom:0;}

  /* service area */
  .area-grid{
    display:grid; grid-template-columns:1.15fr .85fr; gap:28px; align-items:center;
  }
  .map-card{
    position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px;
  }
  .map-card svg.island{
    width:100%; max-width:150px; height:auto; position:relative;
    filter:drop-shadow(0 8px 16px rgba(16,21,27,.16));
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .map-card svg.island{ filter:drop-shadow(0 8px 20px rgba(0,0,0,.55)); }
  }
  :root[data-theme="dark"] .map-card svg.island{ filter:drop-shadow(0 8px 20px rgba(0,0,0,.55)); }
  .map-card .island-shape{fill:none; stroke:var(--ink); stroke-width:6; stroke-linejoin:round;}
  .compass{
    position:absolute; top:0; right:8px; display:flex; flex-direction:column; align-items:center;
    font-family:'IBM Plex Mono'; font-size:.6rem; color:var(--ink-soft); letter-spacing:.06em; gap:2px;
  }
  .map-caption{
    font-family:'IBM Plex Mono'; font-size:.7rem; color:var(--ink-soft); text-align:center;
    letter-spacing:.03em; position:relative; line-height:1.6;
  }
  .map-caption strong{color:var(--ink); font-weight:600;}
  .area{
    background:var(--blue); color:#fff; border-radius:16px; padding:36px;
    display:flex; flex-direction:column; justify-content:center; gap:14px;
    position:relative; overflow:hidden; height:100%;
  }
  .area::after{
    content:""; position:absolute; inset:0; pointer-events:none;
    background: radial-gradient(circle at 88% -10%, rgba(255,199,44,.28), transparent 55%);
  }
  .area h3{color:#fff; font-size:clamp(1.25rem,2.2vw,1.55rem); position:relative; text-transform:uppercase; font-family:'Oswald';}
  .area p{color:#c9d6f4; max-width:42ch; position:relative;}
  .area .call-btn{background:var(--gold-bright); color:var(--blue-deep); position:relative; align-self:flex-start;}
  .area .call-btn:hover{background:#fff;}
  @media (max-width:820px){ .area-grid{grid-template-columns:1fr;} }

  /* contact */
  .contact-grid{display:grid; grid-template-columns:.85fr 1.15fr; gap:44px; align-items:start; min-width:0;}
  .contact-grid > *{min-width:0;}
  .contact-list{display:flex; flex-direction:column; gap:18px; min-width:0;}
  .contact-item{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:12px;
    display:flex; align-items:center; gap:8px; padding:8px 10px 8px 20px;
    box-shadow:var(--shadow); transition:border-color .15s;
  }
  .contact-item:hover{border-color:var(--blue);}
  .contact-item .contact-main{
    flex:1; min-width:0; display:flex; align-items:center; gap:14px;
    text-decoration:none; color:var(--ink); padding:10px 0;
  }
  .contact-item .ci-icon{
    width:38px;height:38px;border-radius:9px;background:var(--blue-tint);color:var(--blue);
    display:flex;align-items:center;justify-content:center; flex:none;
  }
  .contact-item .ci-label{display:block; font-size:.72rem; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.08em; font-family:'IBM Plex Mono';}
  .contact-item .ci-value{display:block; font-weight:600; font-size:1.02rem; margin-top:2px; overflow-wrap:anywhere;}
  .contact-item .ci-sub{display:block; font-weight:400; font-size:.82rem; color:var(--ink-soft); margin-top:3px;}
  .wa-link{
    width:42px; height:42px; border-radius:50%; flex:none;
    display:flex; align-items:center; justify-content:center;
    background:var(--wa); text-decoration:none;
    box-shadow:0 2px 6px -1px rgba(0,0,0,.35);
    transition:transform .15s, box-shadow .15s;
  }
  .wa-link:hover{background:var(--wa); transform:scale(1.07); box-shadow:0 4px 10px -1px rgba(0,0,0,.4);}
  .wa-link svg{display:block;}

  form.quote{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:14px;
    padding:28px; box-shadow:var(--shadow);
  }
  form.quote .grid2{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .field{display:flex; flex-direction:column; gap:6px; margin-top:16px;}
  .field:first-child, form.quote .grid2 .field{margin-top:0;}
  .field label{font-size:.78rem; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.05em;}
  .field input, .field select, .field textarea{
    font-family:'Work Sans'; font-size:.96rem; color:var(--ink);
    background:var(--paper); border:1px solid var(--line); border-radius:8px;
    padding:11px 12px; width:100%;
  }
  .field textarea{resize:vertical; min-height:96px;}
  .field input:focus, .field select:focus, .field textarea:focus{outline:2px solid var(--blue); outline-offset:1px;}
  form.quote button{
    margin-top:18px; width:100%; background:var(--blue); color:#fff; border:none;
    font-family:'Work Sans'; font-weight:600; font-size:.96rem; padding:13px; border-radius:8px;
    cursor:pointer; transition:background .15s;
  }
  form.quote button:hover{background:var(--blue-deep);}
  .form-note{font-size:.78rem; color:var(--ink-soft); margin-top:10px;}
  @media (max-width:820px){ .contact-grid{grid-template-columns:1fr;} form.quote .grid2{grid-template-columns:1fr;} }

  footer{border-top:1px solid var(--line); padding:28px 0 36px; background:var(--paper-raised);}
  .foot-payments{
    display:flex; flex-direction:column; align-items:center; gap:8px;
    padding-bottom:22px; margin-bottom:22px; border-bottom:1px solid var(--line);
    font-family:'IBM Plex Mono'; font-size:.74rem; letter-spacing:.04em; color:var(--ink-soft);
    text-transform:uppercase; text-align:center;
  }
  .foot-payments .fp-label{color:var(--ink); font-weight:600;}
  .foot-payments .fp-list{display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;}
  .foot-payments .fp-sep{color:var(--line);}
  .foot-row{display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;}
  .foot-brand{display:flex; align-items:center; gap:10px;}
  .foot-brand img{height:32px;width:auto;}
  .foot-brand span{font-family:'Oswald'; text-transform:uppercase; font-size:.92rem; letter-spacing:.02em;}
  footer .meta{font-size:.78rem; color:var(--ink-soft); font-family:'IBM Plex Mono';}
</style>
</head>
<body>
<header>
  <div class="nav-row wrap">
    <a class="brand" href="#top">
      <img src="data:image/webp;base64," alt="N &amp; N Lyte's Plumbing Services logo">
      <span class="brand-text">
        <strong>N &amp; N Lyte's</strong>
        <span>PLUMBING SERVICES · BARBADOS</span>
      </span>
    </a>
    <nav class="links">
      <a href="#services">Services</a>
      <a href="#work">Our Work</a>
      <a href="#about">About</a>
      <a href="#area">Service Area</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<main id="top">
  <div class="wrap hero">
    <div class="hero-badge">
      <img src="data:image/webp;base64," alt="N &amp; N Lyte's Plumbing Services badge logo">
    </div>
    <div class="hero-copy">
      <span class="eyebrow">Reliable Solutions. Lasting Results.</span>
      <h1>Plumbing <em>Barbados</em> can count on.</h1>
      <p class="lede">N &amp; N Lyte's is a father-and-son plumbing outfit working across Barbados — household repairs, new-build water mains, and the temporary plumbing that keeps a soca fete or garden party running clean.</p>
      <div class="hero-ctas">
        <a class="call-btn" href="tel:+12462619245">Call for a quote</a>
        <a class="btn-outline" href="#contact">Send us the details →</a>
      </div>
    </div>
  </div>

  <div class="trust">
    <div class="wrap trust-row">
      <div><span class="dot"></span><span><strong>Family-Owned &amp; Operated</strong> · two generations, hands-on every job</span></div>
      <div><span class="dot"></span><span><strong>Island-Wide Coverage</strong> · residential, commercial &amp; event</span></div>
      <div><span class="dot"></span><span><strong>Transparent Pricing</strong> · written estimates, proper invoicing</span></div>
    </div>
  </div>

  <hr class="pipe-rule">

  <section id="services">
    <div class="wrap">
      <div class="section-head" style="max-width:none;">
        <span class="eyebrow">What we do</span>
        <h2 style="text-wrap:normal;">Four kinds of job, one standard of work</h2>
        <p style="max-width:60ch;">From a running toilet to a subdivision's water main, every job gets the same site visit, straight talk on cost, and clean finish.</p>
      </div>

      <div class="svc-grid">

        <div class="svc-card">
          <div class="svc-top">
            <div class="svc-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><path d="M12 5V2M12 22v-3M5 12H2M22 12h-3M7.05 7.05 4.93 4.93M19.07 19.07l-2.12-2.12M7.05 16.95 4.93 19.07M19.07 4.93l-2.12 2.12"/></svg>
            </div>
            <span class="svc-tag">01 · DEVELOPMENT</span>
          </div>
          <h3>Water Main &amp; Development Installations</h3>
          <ul>
            <li>Water main installation for new housing developments</li>
            <li>Underground pipe fitting &amp; connection to existing supply</li>
            <li>Pressure and leak testing</li>
            <li>Support for contractors &amp; new construction projects</li>
          </ul>
        </div>

        <div class="svc-card">
          <div class="svc-top">
            <div class="svc-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
            </div>
            <span class="svc-tag">02 · HOUSEHOLD</span>
          </div>
          <h3>Residential Plumbing</h3>
          <ul>
            <li>Toilet installation &amp; repairs</li>
            <li>Shower installation &amp; maintenance</li>
            <li>Kitchen sink &amp; pipe installations</li>
            <li>Leak repairs, drains &amp; blockages</li>
          </ul>
        </div>

        <div class="svc-card">
          <div class="svc-top">
            <div class="svc-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 10h18L12 3Z"/><path d="M4 10v10M20 10v10M12 10v10"/><path d="M8 20v-4M16 20v-4"/></svg>
            </div>
            <span class="svc-tag">03 · EVENTS</span>
          </div>
          <h3>Event Plumbing</h3>
          <ul>
            <li>Temporary sink installations for fetes &amp; luncheons</li>
            <li>Water line set-up for garden parties &amp; outdoor functions</li>
            <li>Wastewater drainage for soca events &amp; corporate gatherings</li>
            <li>Booked ahead for private &amp; large-scale functions</li>
          </ul>
        </div>

        <div class="svc-card">
